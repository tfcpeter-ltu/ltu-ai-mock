    },
    {
      "start": 21.0,
      "end": 24.0,
      "text": "That's a special unit we have here that deals with this type of thing.",
      "avgLogprob": -0.18514980492384536
    },
    {
      "start": 24.0,
      "end": 29.0,
      "text": "They'll take some more details from you and give you a crime reference number.",
      "avgLogprob": -0.18514980492384536
